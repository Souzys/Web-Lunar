# ==============================================================================
# Git Ignore - Web Lunar (Next.js & Fullstack Production Safe)
# ==============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js Build Output & Cache
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# Environment Variables & Secrets (CRÍTICO: Nunca commitar segredos!)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Certificates & Private Keys
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# Database & Storage
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm

# Testing & Coverage
/coverage

# Logs & Debugging
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# OS & System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE & Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# Vercel / Deployment artifacts
.vercel
