# ==============================================================================
# Web Lunar - Environment Variables Template (.env.example)
# Duplicate this file as .env and fill in your real credentials locally.
# NEVER commit real .env files with production secrets to GitHub!
# ==============================================================================

# Database Connection
# Ex: postgresql://USER:PASSWORD@localhost:5432/web_lunar?schema=public
DATABASE_URL="postgresql://lunar_user:lunar_password@localhost:5432/web_lunar?schema=public"

# Redis Cache URL
REDIS_URL="redis://localhost:6379"

# NextAuth Configuration
# Generate a secure secret using: openssl rand -base64 32
NEXTAUTH_SECRET="your_nextauth_secret_key_here"
NEXTAUTH_URL="http://localhost:3000"

# Admin Access Credentials (Required for dashboard access)
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="your_super_secret_admin_password"

# Resend Email Config (Transactional contact emails)
# Get your API key at: https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Web Lunar <contato@yourdomain.com>"
CONTACT_DESTINATION_EMAIL="contato@yourdomain.com"
